---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const services = [
  "UX/UI Design",
  "Product Design",
  "UX Research",
  "Content Creation",
  "Branding",
  "Illustration",
  "Prototyping",
];
---

<BaseLayout title="About Me">
	<section class="max-w-7xl mx-auto px-6 py-24 md:py-32">
		<div class="grid grid-cols-1 md:grid-cols-2 gap-16 md:gap-24 items-start">
			<div class="aspect-[4/5] bg-gray-100 overflow-hidden relative group md:sticky md:top-32">
				<img src={`/contenido%20web/photoabout.avif`} alt="Jessica Duran" class="absolute inset-0 w-full h-full object-cover transition-opacity duration-500 ease-out group-hover:opacity-0" />
				<img src={`/contenido%20web/photoabout2.avif`} alt="Jessica Duran" class="absolute inset-0 w-full h-full object-cover opacity-0 transition-opacity duration-500 ease-out group-hover:opacity-100" />
			</div>
			
			<div class="space-y-12">
				<div class="space-y-6">
					<h1 class="text-4xl md:text-5xl italic font-serif font-medium text-gray-900 leading-tight">
						{t('about.title')}
						<svg class="inline-block w-7 h-7 md:w-9 md:h-9 ml-2 align-middle text-gray-900" viewBox="0 0 32 32" fill="currentColor" aria-hidden="true"><path d="M16 1.5 C16.6 11.2 20.8 15.4 30.5 16 C20.8 16.6 16.6 20.8 16 30.5 C15.4 20.8 11.2 16.6 1.5 16 C11.2 15.4 15.4 11.2 16 1.5 Z"/></svg>
					</h1>
					<div class="flex flex-wrap gap-2 pt-2">
						{services.map(service => (
							<span class="px-3 py-1 rounded-full text-[11px] uppercase tracking-[0.15em] text-gray-600 border border-gray-300/70 hover:bg-[#E0A4B0] hover:border-[#E0A4B0] hover:text-white transition-all duration-300 cursor-default">
								{service}
							</span>
						))}
					</div>
					<p class="text-xl italic font-serif font-light text-gray-600 leading-relaxed pt-2">
						Hi! I'm Jessica — but everyone calls me Jeka. I'm a UX/UI designer with a background in graphic design, passionate about creating experiences that connect with people — on a screen, on social media, or on skin.
					</p>
					<p class="text-xl italic font-serif font-light text-gray-600 leading-relaxed">
						As a UX/UI designer I've grown at two amazing startups, Salomoni and Grip, solving real user problems with empathy and purpose. I also work as a content creator for social media, combining strategy, visual design, and illustration to help brands communicate authentically.
					</p>
					<p class="text-xl italic font-serif font-light text-gray-600 leading-relaxed">
						My entrepreneurial spirit led me to start Animalovers, a brand of personalized products for pets and their humans, and By Jeka, my creative brand where I do fine line tattooing to turn stories into unique pieces.
					</p>
					<p class="text-xl italic font-serif font-light text-gray-600 leading-relaxed">
						I believe design is a powerful tool to tell stories, express identity, and make an impact. I'm always learning and exploring new ways to improve my craft.
					</p>
					<p class="text-xl italic font-serif font-light text-gray-600 leading-relaxed">
						When I'm not designing, you'll probably find me working out, spending time with my cats and family, dancing, illustrating, trying new restaurants, or exploring hidden corners of beautiful Barcelona.
					</p>
					<p class="text-xl italic font-serif text-gray-800 leading-relaxed pt-2">
						Let's create something meaningful together.
						<svg class="inline-block w-5 h-5 ml-1.5 align-middle text-gray-800" viewBox="0 0 32 32" fill="currentColor" aria-hidden="true"><path d="M16 1.5 C16.6 11.2 20.8 15.4 30.5 16 C20.8 16.6 16.6 20.8 16 30.5 C15.4 20.8 11.2 16.6 1.5 16 C11.2 15.4 15.4 11.2 16 1.5 Z"/></svg>
					</p>
					<div class="pt-4">
						<a
							href={`/cv-jessica-duran.pdf`}
							download
							class="inline-flex items-center gap-2 border-2 border-gray-900 text-gray-900 px-6 py-3 text-[11px] font-bold uppercase tracking-[0.2em] rounded-full hover:bg-[#E0A4B0] hover:border-[#E0A4B0] hover:text-white transition-all duration-500"
						>
							<svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
								<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
								<polyline points="7 10 12 15 17 10"></polyline>
								<line x1="12" y1="15" x2="12" y2="3"></line>
							</svg>
							Download CV
						</a>
					</div>
				</div>

			</div>
		</div>
	</section>
</BaseLayout>
